# Production deployment configuration. Replace placeholders using the secret manager.
NODE_ENV=production
APP_DEPLOYMENT_MODE=production
HOST=0.0.0.0
PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dedicated-production-db>
JWT_SECRET=<minimum-32-character-secret>
CORS_ALLOWED_ORIGINS=https://<frontend-domain>
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=<rotated-production-token>
MOCK_COURIER_ADAPTER_ENABLED=false
DELHIVERY_PICKUP_CREATION_ENABLED=false
